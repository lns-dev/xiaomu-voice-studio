{
  "name": "local-voice-studio",
  "version": "0.1.0-alpha.8",
  "private": true,
  "description": "Local voice design and voice cloning desktop studio",
  "author": "XiaoMu Voice Studio",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "build:icon": "python scripts/build-icon.py",
    "validate:release-tool": "node scripts/validate-release-tool.cjs",
    "pack:debug": "node scripts/validate-release-tool.cjs && electron-builder --config electron-builder.debug.yml --win dir --x64",
    "dist:win": "node scripts/validate-release-tool.cjs && electron-builder --config electron-builder.yml --win nsis --x64"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.7"
  }
}
